{
  "name": "DALEH Flutter",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash .devcontainer/install-flutter.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Flutter web preview",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.flutter", "Dart-Code.dart-code"]
    }
  }
}
