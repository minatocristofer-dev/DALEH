# Copie este arquivo para ".env" e preencha com os valores reais.

# String de conexão do PostgreSQL usada pela API em runtime.
# Local: postgresql://usuario:senha@localhost:5432/daleh?schema=public
# Supabase (via pooler/PgBouncer, porta 6543): postgresql://postgres.[PROJETO]:[SENHA]@[HOST-POOLER]:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daleh?schema=public"

# Conexão direta com o banco, usada só pelo Prisma para rodar migrations.
# Local: pode repetir o mesmo valor do DATABASE_URL.
# Supabase: use o pooler em modo "session" (porta 5432, mesmo host do pooler),
# não o host "db.[PROJETO].supabase.co" — esse só responde em IPv6 e falha em
# provedores sem rota IPv6 (ex: Render).
# postgresql://postgres.[PROJETO]:[SENHA]@[HOST-POOLER]:5432/postgres
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/daleh?schema=public"

# Porta em que a API vai rodar
PORT=3000

# Segredo usado para assinar os tokens JWT — troque por um valor aleatório longo em produção
JWT_SECRET="troque-este-valor-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"
